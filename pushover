#!/bin/bash

set -u

VERSION="2.0.0"
CONFIG_FILE="${HOME}/.config/pushover-cli/global.env"
API_URL="https://api.pushover.net/1/messages.json"

USER_KEY=""
APP_TOKEN=""
TITLE=""
MESSAGE=""
URL=""
URL_TITLE=""
DEVICE=""
SOUND=""
HTML=""
MONOSPACE=""
TIMESTAMP=""
PRIORITY="0"
RETRY="60"
EXPIRE="3600"
QUIET=""

usage() {
	cat <<EOF
pushover v${VERSION} — send a Pushover notification.

USAGE:
  pushover --message "..." [OPTIONS]

REQUIRED:
  --message TEXT         Notification body.

AUTHENTICATION:
  --user KEY             Pushover user key.
  --token TOKEN          Pushover application API token.

  Tokens are resolved in this order; first match wins, with no fallback chaining:
    1. CLI flag (--user, --token)
    2. Environment variable (PUSHOVER_USER_KEY, PUSHOVER_APP_TOKEN)
    3. ${CONFIG_FILE}

OPTIONS:
  --title TEXT           Notification title.
  --url URL              Supplementary URL.
  --url-title TEXT       Title for the supplementary URL.
  --device LIST          Target device(s), comma-separated. Default: all devices.
  --sound NAME           Notification sound. See https://pushover.net/api#sounds
  --html 1               Render HTML in the message body.
  --monospace 1          Render the message body in monospace. Mutually exclusive
                         with --html.
  --timestamp UNIX       Override the message timestamp.
  --priority N           Message priority, -2..2. Default: ${PRIORITY}.
                         See https://pushover.net/api#priority
  --retry SECONDS        Retry interval for priority 2. Default: ${RETRY}.
  --expire SECONDS       Retry window for priority 2. Default: ${EXPIRE}.

  -q, --quiet            Silence stdout/stderr. Exit code still reflects status.
  -v, --version          Print version and exit.
  -h, --help             Print this help and exit.

ENVIRONMENT:
  PUSHOVER_USER_KEY      Same as --user.
  PUSHOVER_APP_TOKEN     Same as --token.

CONFIG FILE:
  ${CONFIG_FILE}
  Plain text, one KEY="value" per line. Recognized keys: PUSHOVER_USER_KEY,
  PUSHOVER_APP_TOKEN. Recommended permissions: chmod 600.
EOF
}

# --- Arg parsing ---
while [[ $# -gt 0 ]]; do
	case "$1" in
		--user)       USER_KEY="${2:-}"; shift 2 ;;
		--token)      APP_TOKEN="${2:-}"; shift 2 ;;
		--title)      TITLE="${2:-}"; shift 2 ;;
		--message)    MESSAGE="${2:-}"; shift 2 ;;
		--url)        URL="${2:-}"; shift 2 ;;
		--url-title)  URL_TITLE="${2:-}"; shift 2 ;;
		--device)     DEVICE="${2:-}"; shift 2 ;;
		--sound)      SOUND="${2:-}"; shift 2 ;;
		--html)       HTML="${2:-}"; shift 2 ;;
		--monospace)  MONOSPACE="${2:-}"; shift 2 ;;
		--timestamp)  TIMESTAMP="${2:-}"; shift 2 ;;
		--priority)   PRIORITY="${2:-}"; shift 2 ;;
		--retry)      RETRY="${2:-}"; shift 2 ;;
		--expire)     EXPIRE="${2:-}"; shift 2 ;;
		-q|--quiet)   QUIET=1; shift ;;
		-v|--version) echo "pushover v${VERSION}"; exit 0 ;;
		-h|--help)    usage; exit 0 ;;
		*)
			[[ -z "$QUIET" ]] && printf '\033[0;31mpushover: unknown option: %s\033[0m\n' "$1" >&2
			exit 1
		;;
	esac
done

# --- Token resolution: flag > env > global.env ---
# Stage 1: env vars fill anything the flags didn't.
[[ -z "$USER_KEY"  && -n "${PUSHOVER_USER_KEY:-}"  ]] && USER_KEY="$PUSHOVER_USER_KEY"
[[ -z "$APP_TOKEN" && -n "${PUSHOVER_APP_TOKEN:-}" ]] && APP_TOKEN="$PUSHOVER_APP_TOKEN"

# Stage 2: global.env fills anything still empty.
if [[ ( -z "$USER_KEY" || -z "$APP_TOKEN" ) && -f "$CONFIG_FILE" ]]; then
	while IFS= read -r line; do
		case "$line" in
			PUSHOVER_USER_KEY=*)
				if [[ -z "$USER_KEY" ]]; then
					USER_KEY="${line#PUSHOVER_USER_KEY=}"
					USER_KEY="${USER_KEY%\"}"; USER_KEY="${USER_KEY#\"}"
				fi
			;;
			PUSHOVER_APP_TOKEN=*)
				if [[ -z "$APP_TOKEN" ]]; then
					APP_TOKEN="${line#PUSHOVER_APP_TOKEN=}"
					APP_TOKEN="${APP_TOKEN%\"}"; APP_TOKEN="${APP_TOKEN#\"}"
				fi
			;;
		esac
	done < "$CONFIG_FILE"
fi

# --- Validation ---
if [[ -z "$USER_KEY" ]]; then
	[[ -z "$QUIET" ]] && printf '\033[0;31mpushover: missing user key (pass --user, set PUSHOVER_USER_KEY, or add to %s)\033[0m\n' "$CONFIG_FILE" >&2
	exit 1
fi
if [[ -z "$APP_TOKEN" ]]; then
	[[ -z "$QUIET" ]] && printf '\033[0;31mpushover: missing app token (pass --token, set PUSHOVER_APP_TOKEN, or add to %s)\033[0m\n' "$CONFIG_FILE" >&2
	exit 1
fi
if [[ -z "$MESSAGE" ]]; then
	[[ -z "$QUIET" ]] && printf '\033[0;31mpushover: missing --message\033[0m\n' >&2
	exit 1
fi

# --- Send ---
RESPONSE=$(curl -s \
	-F "token=${APP_TOKEN}" \
	-F "user=${USER_KEY}" \
	-F "title=${TITLE}" \
	-F "message=${MESSAGE}" \
	-F "url=${URL}" \
	-F "url_title=${URL_TITLE}" \
	-F "device=${DEVICE}" \
	-F "sound=${SOUND}" \
	-F "html=${HTML}" \
	-F "monospace=${MONOSPACE}" \
	-F "timestamp=${TIMESTAMP}" \
	-F "priority=${PRIORITY}" \
	-F "retry=${RETRY}" \
	-F "expire=${EXPIRE}" \
	"$API_URL")

if [[ "$RESPONSE" == *'"status":1'* ]]; then
	[[ -z "$QUIET" ]] && printf '\033[0;37mpushover: sent\033[0m\n'
	exit 0
else
	[[ -z "$QUIET" ]] && printf '\033[0;31mpushover: API error: %s\033[0m\n' "$RESPONSE" >&2
	exit 1
fi
